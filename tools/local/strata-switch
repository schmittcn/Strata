#!/bin/sh
# strata-switch coder|iq2|swift|ornith|ornith-q6|<model id>|stop|status|update-check|update|apply|edit|help: manage the local Strata server
set -eu
SRC="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
PORT=8095      # must match baseURL in opencode.json and "port" in ~/.config/strata/patches.json
URL=http://127.0.0.1:$PORT/v1/models

# models run as `strata runtime` profiles; our settings live in ~/.config/strata/patches.json and are applied by
# strata-profiles (from the Omarchy Strata plugin, linked into ~/.local/bin). This checkout's own CLI is used, so the
# runtime serves this checkout's server code and engine, not the ones of the installed Strata Terminal.
export STRATA_CLI="env STRATA_PYTHON=$SRC/.venv/bin/python $SRC/bin/strata"
command -v strata-profiles >/dev/null || { echo "strata-profiles not found: ln -s <plugin dir>/strata-profiles.py ~/.local/bin/strata-profiles" >&2; exit 1; }

current() { curl -s -m 3 "$URL" | python3 -c 'import sys,json; print("\n".join(m["id"] for m in json.load(sys.stdin)["data"]))' 2>/dev/null || true; }
running_id() { strata-profiles info | python3 -c 'import sys,json; print(next((m["id"] for m in json.load(sys.stdin)["models"] if m["state"] != "stopped"), ""))'; }

# our changes are commits on branch `local` (fork: origin = schmittcn/Strata, upstream = Niko1221/Strata);
# an update rebases them onto upstream/main, pushes both branches to the fork and rebuilds the engine
update_src() {
  cd "$SRC"
  [ "$(git branch --show-current)" = local ] || { echo "$SRC is not on branch local, nothing touched" >&2; exit 1; }
  [ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes in $SRC, commit them on local first (git status)" >&2; exit 1; }
  bk="$STATE/strata-backup/$(date +%Y%m%d-%H%M%S)"; mkdir -p "$bk"
  cp strata-*.json "$bk"/; echo "old head $(git rev-parse --short HEAD)" > "$bk/HEAD.txt"
  echo "backup of configs: $bk"
  git fetch -q upstream
  [ "$(git merge-base HEAD upstream/main)" = "$(git rev-parse upstream/main)" ] && echo "already up to date"
  strata-profiles stop
  if ! git rebase -q upstream/main; then
    git rebase --abort
    echo "our commits on local conflict with upstream: nothing changed. By hand: cd $SRC && git rebase upstream/main" >&2; exit 1
  fi
  git branch -f main upstream/main
  # before update.sh: its `git pull --ff-only` follows origin/local, which must already be the rebased branch
  git push -q origin main && git push -q --force-with-lease origin local || echo "WARNING: push to the fork failed, continuing" >&2
  echo "update.sh (engine rebuild can take 10-20 min) ..."
  ./update.sh
  echo "configs setup changed:"; diff -r -q "$bk" . 2>/dev/null | grep -E 'strata-.*json' || echo "  (none)"
  echo "re-applying our settings:"; strata-profiles apply
}

case "${1:-}" in
  coder) id=coder-iq1_m ;;
  iq2)   id=iq2_xs ;;
  swift) id=swift-iq3_s ;;
  ornith) id=ornith-iq4_xs ;;
  ornith-q6) id=ornith-q6_k ;;
  stop)  strata-profiles stop; exit 0 ;;
  status) m=$(current); [ -n "$m" ] && echo "$m" || echo "no server on :$PORT"; exit 0 ;;
  update-check)
    cd "$SRC"; git fetch -q upstream
    echo "installed: $(git log -1 --format='%h %cd' --date=short "$(git merge-base HEAD upstream/main)")   upstream: $(git log -1 --format='%h %cd' --date=short upstream/main)"
    [ "$(git merge-base HEAD upstream/main)" = "$(git rev-parse upstream/main)" ] && echo "up to date" || echo "update available ($(git rev-list --count HEAD..upstream/main) commits): strata-switch update"
    exit 0 ;;
  apply|repatch) strata-profiles apply; exit 0 ;;
  edit) ${VISUAL:-${EDITOR:-nvim}} "$(strata-profiles edit)" && strata-profiles apply; exit 0 ;;
  update)
    id=$(running_id)
    update_src
    [ -n "$id" ] || { echo "update done; no model was running, none started"; exit 0; } ;;
  help|-h|--help) cat <<'EOF'
strata-switch: manage the local Strata server (port 8095)

  strata-switch coder         start Coder IQ1_M (faster, for code, with F16)
  strata-switch iq2           start IQ2_XS (general, less RAM, with F16)
  strata-switch swift         start Swift 1.5 IQ3_S (best quality, slower, about 50-60 GB RAM, 128K)
  strata-switch ornith        start Ornith 1.5 35B-A3B IQ4_XS (mradermacher i1; Qwen3.6 path, 256K, fast)
  strata-switch ornith-q6     start Ornith 1.5 35B-A3B Q6_K (official GGUF; 128K, best quality, slower)
  strata-switch <model id>    start any model `strata models list` shows
  strata-switch status        show the loaded model
  strata-switch stop          stop the server, free GPU and RAM
  strata-switch update-check  only check whether there is a new version
  strata-switch update        back up the configs, fetch the new version, rebuild the engine (our commits on
                              branch local are rebased onto upstream and pushed to the fork), re-apply our
                              settings, start the model again
  strata-switch apply         re-apply our settings (~/.config/strata/patches.json) to the profiles
  strata-switch edit          edit our settings, then apply them
  strata-switch help          this help

A running server is stopped first. Loading takes up to about 2 min.
Settings: ~/.config/strata/patches.json   Patched configs: ~/.config/strata/configs/
Log: ~/.local/state/strata/runtime/<model id>.server.log   Backups: ~/.local/state/strata-backup/
Monitor: strata monitor --once   (web UI: http://127.0.0.1:8095/)
EOF
    exit 0 ;;
  ""|-*) echo "usage: strata-switch coder|iq2|swift|ornith|ornith-q6|<model id>|stop|status|update-check|update|apply|edit|help" >&2; exit 2 ;;
  *) id=$1 ;;
esac

exec strata-profiles start "$id"
